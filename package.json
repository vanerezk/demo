{
  "name": "catalog-sync-prestashop",
  "version": "0.1.0",
  "private": true,
  "description": "Integra catálogos de proveedores externos en PrestaShop 1.7 como productos nativos.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "cli": "tsx src/cli.ts",
    "catalog:preview": "tsx src/cli.ts catalog:preview",
    "ps:ping": "tsx src/cli.ts ps:ping",
    "ps:demo-product": "tsx src/cli.ts ps:demo-product",
    "setup:webservice": "./scripts/setup-webservice.sh",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "csv-parse": "^7.0.3",
    "dotenv": "^18.0.9",
    "fast-xml-parser": "^5.11.2",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.19.43",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^3.2.7"
  }
}
