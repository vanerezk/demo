# --- PrestaShop (entorno local con Docker) ---
PS_HTTP_PORT=8080
PS_ADMIN_MAIL=demo@example.com
PS_ADMIN_PASSWORD=cambia_esto
DB_ROOT_PASSWORD=cambia_esto

# --- Webservice ---
# URL pública de la tienda y clave de API (32 caracteres A-Z0-9).
# Genera una con:  LC_ALL=C tr -dc 'A-Z0-9' </dev/urandom | head -c 32
PS_BASE_URL=http://localhost:8080
PS_WEBSERVICE_KEY=REEMPLAZA_CON_32_CARACTERES_A_Z09
# Idioma en el que se escriben los contenidos (id de ps_lang; 1 en una instalación monoidioma)
PS_ID_LANG=1
# Tienda y categoría por defecto (2 = "Inicio" en una instalación limpia)
PS_ID_SHOP=1
PS_DEFAULT_CATEGORY_ID=2
# Grupo de reglas de impuestos (1 = IVA ES 21 % en una instalación con país ES)
PS_TAX_RULES_GROUP_ID=1

# --- Logs ---
LOG_LEVEL=info

# --- Precios ---
# Tipo de cambio: "fixed" usa USD_EUR_RATE; "ecb" consulta el BCE (con USD_EUR_RATE como respaldo)
EXCHANGE_RATE_SOURCE=fixed
# EUR que vale 1 USD
USD_EUR_RATE=0.92
VAT_PCT=21
# Redondeo comercial del PVP: none | integer (…,00) | ends-in-9 (…9,00)
PRICE_ROUNDING=ends-in-9
# Margen sobre coste por proveedor, en % (100 = el doble del coste)
SUPPLIER_A_MARGIN_PCT=90
SUPPLIER_B_MARGIN_PCT=80
DEFAULT_MARGIN_PCT=100

# --- Catálogo ---
# Prefijo de las referencias públicas propias (STR-AL-000123)
REFERENCE_PREFIX=STR-AL
# Ubicación de los feeds (ruta local o URL). Por defecto, los fixtures de ejemplo.
# SUPPLIER_A_FEED=https://proveedor-a.example/feed.json
# SUPPLIER_B_FEED=https://proveedor-b.example/tarifa.csv
